<%- include("partials/header") %>

<h1>Notebookok az adatbázisban</h1>
<% if (gepek.length === 0) { %>
    <p>Az adatbázisban még nincs notebook.</p>
<% } else { %>
    <% const szam = new Intl.NumberFormat("hu-HU"); %>
    <p>A katalógusban <strong><%= gepek.length %></strong> notebook szerepel.</p>
    <div class="table-wrapper">
        <table class="alt">
            <thead>
                <tr>
                    <th scope="col">Gyártó</th>
                    <th scope="col">Típus</th>
                    <th scope="col">Kijelző</th>
                    <th scope="col">Memória</th>
                    <th scope="col">Tárhely</th>
                    <th scope="col">Videovezérlő</th>
                    <th scope="col">Processzor</th>
                    <th scope="col">Operációs rendszer</th>
                    <th scope="col">Ár</th>
                    <th scope="col">Készlet</th>
                </tr>
            </thead>
            <tbody>
                <% for (const gep of gepek) { %>
                    <tr>
                        <td><%= gep.gyarto %></td>
                        <td><%= gep.tipus %></td>
                        <td><%= szam.format(gep.kijelzo) %>″</td>
                        <td><%= szam.format(gep.memoria) %> MB</td>
                        <td><%= szam.format(gep.merevlemez) %> GB</td>
                        <td><%= gep.videovezerlo || "—" %></td>
                        <td><%= processzorNevek.get(gep.processzorid) ?? "Nincs megadva" %></td>
                        <td><%= oprendszerNevek.get(gep.oprendszerid) ?? "Nincs megadva" %></td>
                        <td><%= szam.format(gep.ar) %> Ft</td>
                        <td><%= szam.format(gep.db) %> db</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include("partials/footer") %>
